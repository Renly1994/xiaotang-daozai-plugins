{
  "id": "daozai.gold",
  "name": "现货金价",
  "titleAccent": "金价",
  "author": "岛仔",
  "version": "1.0.2",
  "navigationIcon": {
    "path": "M8 5H16L17.5 10H6.5Z M5 13.5H9L10.5 18.5H3.5Z M15 13.5H19L20.5 18.5H13.5Z",
    "background": "#94620C"
  },
  "api": 1,
  "runtime": "js",
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "status",
  "capabilities": ["status.page", "status.canvas", "action", "notice", "storage", "island.pinned", "settings", "timer"],
  "dataVersion": 1,
  "permissions": {"source.read": "https"},
  "refreshSeconds": 300,
  "network": {
    "hosts": ["xaus.com", "qt.gtimg.cn"],
    "sources": [
      {"key": "usd", "url": "https://xaus.com/api/v1/spot?currency=USD&unit=oz&compact=1"},
      {"key": "cny", "url": "https://xaus.com/api/v1/spot?currency=CNY&unit=gram&compact=1"},
      {"key": "tencent", "url": "https://qt.gtimg.cn/utf8/q=hf_XAU,whUSDCNY"}
    ],
    "minRefreshSeconds": 60
  },
  "attribution": {"label": "XAUS / 腾讯行情"},
  "settings": [
    {"key": "unit", "label": "计价单位", "type": "choice", "default": "cny", "choices": [{"value": "usd", "label": "美元 / 盎司"}, {"value": "cny", "label": "人民币 / 克"}]},
    {"key": "range", "label": "走势区间", "type": "choice", "default": "day", "choices": [{"value": "day", "label": "1日"}, {"value": "week", "label": "1周"}, {"value": "month", "label": "1月"}]},
    {"key": "alert_usd", "label": "美元提醒价（0 为关闭）", "type": "number", "default": "0", "min": 0, "max": 100000, "step": 0.01, "precision": 2},
    {"key": "alert_cny", "label": "人民币提醒价（0 为关闭）", "type": "number", "default": "0", "min": 0, "max": 100000, "step": 0.01, "precision": 2},
    {"key": "up_color", "label": "涨跌颜色", "type": "choice", "default": "red", "choices": [{"value": "red", "label": "红涨绿跌"}, {"value": "green", "label": "绿涨红跌"}]}
  ],
  "statusLayout": {
    "components": [{"type": "canvas"}],
    "style": {"accent": "#E8B931", "icon": "chart"}
  }
}
