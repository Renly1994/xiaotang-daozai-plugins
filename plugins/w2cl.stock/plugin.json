{
  "id": "w2cl.stock",
  "name": "自选股",
  "titleAccent": "选股",
  "author": "w2cl",
  "version": "1.0.1",
  "api": 1,
  "runtime": "js",
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "status",
  "capabilities": [
    "status.page",
    "status.canvas",
    "action",
    "notice",
    "storage",
    "island.pinned",
    "settings",
    "timer"
  ],
  "dataVersion": 1,
  "permissions": {
    "source.read": "https"
  },
  "refreshSeconds": 60,
  "network": {
    "hosts": ["qt.gtimg.cn", "ifzq.gtimg.cn", "web.ifzq.gtimg.cn", "gu.qq.com"],
    "sources": [
      {
        "key": "quotes",
        "url": "https://qt.gtimg.cn/utf8/q={settings.index},{settings.a},{settings.b}"
      },
      {
        "key": "a",
        "url": "https://web.ifzq.gtimg.cn/appstock/app/minute/query?code={settings.a}"
      },
      {
        "key": "b",
        "url": "https://web.ifzq.gtimg.cn/appstock/app/minute/query?code={settings.b}"
      }
    ],
    "minRefreshSeconds": 60
  },
  "attribution": {
    "label": "腾讯行情"
  },
  "navigationIcon": {
    "path": "M4 18 H20 M5 14 L9 10 L13 13 L19 6",
    "background": "#E24B4B"
  },
  "settings": [
    {
      "key": "title",
      "label": "组合名称",
      "type": "text",
      "default": "自选"
    },
    {
      "key": "index",
      "label": "上方指数",
      "type": "choice",
      "default": "sh000001",
      "choices": [
        { "value": "sh000001", "label": "上证指数" },
        { "value": "sz399001", "label": "深证成指" },
        { "value": "sz399006", "label": "创业板指" },
        { "value": "sh000300", "label": "沪深300" },
        { "value": "sh000016", "label": "上证50" },
        { "value": "sh000688", "label": "科创50" }
      ]
    },
    {
      "key": "a",
      "label": "自选1（小写带前缀，点列表即切换）",
      "type": "text",
      "default": "sh600519"
    },
    {
      "key": "b",
      "label": "自选2（小写带前缀，点列表即切换）",
      "type": "text",
      "default": "sz000001"
    },
    {
      "key": "up_color",
      "label": "涨跌颜色",
      "type": "choice",
      "default": "red",
      "choices": [
        { "value": "red", "label": "红涨绿跌" },
        { "value": "green", "label": "绿涨红跌" }
      ]
    },
    {
      "key": "alert_pct",
      "label": "涨跌幅提醒（0 为关闭）",
      "type": "number",
      "default": "0",
      "min": 0,
      "max": 20,
      "step": 0.1,
      "precision": 1
    },
    {
      "key": "alerts",
      "label": "止盈止损与价格提醒",
      "type": "list",
      "default": "[]",
      "maxItems": 8,
      "item": [
        {
          "key": "code",
          "label": "代码",
          "type": "text",
          "default": "sh600519"
        },
        {
          "key": "name",
          "label": "名称",
          "type": "text",
          "default": "贵州茅台"
        },
        {
          "key": "cost",
          "label": "买入价（0 为不设）",
          "type": "number",
          "default": "0",
          "min": 0,
          "max": 1000000,
          "step": 0.01,
          "precision": 2
        },
        {
          "key": "stop_pct",
          "label": "止损（%，0 为关闭）",
          "type": "number",
          "default": "0",
          "min": 0,
          "max": 99,
          "step": 0.1,
          "precision": 1
        },
        {
          "key": "take_pct",
          "label": "止盈（%，0 为关闭）",
          "type": "number",
          "default": "0",
          "min": 0,
          "max": 1000,
          "step": 0.1,
          "precision": 1
        },
        {
          "key": "price",
          "label": "提醒价",
          "type": "number",
          "default": "0",
          "min": 0,
          "max": 1000000,
          "step": 0.01,
          "precision": 2
        },
        {
          "key": "since",
          "label": "生效日期",
          "type": "date",
          "default": "2026-01-01"
        }
      ]
    }
  ],
  "statusLayout": {
    "components": [{ "type": "canvas" }],
    "style": {
      "accent": "#E24B4B",
      "icon": "chart",
      "surface": "card"
    }
  }
}
