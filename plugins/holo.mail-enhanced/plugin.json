{
  "id": "holo.mail-enhanced",
  "name": "邮箱（增强）",
  "author": "Holo.",
  "version": "1.0.7",
  "api": 1,
  "runtime": "assets",
  "entry": "mail-view.json",
  "cover": "cover.png",
  "owner": "mail",
  "capabilities": [
    "mail.view",
    "settings"
  ],
  "dataVersion": 1,
  "permissions": {},
  "settings": [
    {
      "key": "start_date",
      "label": "邮件起始日期（含当天，0001-01-01 表示不限）",
      "type": "date",
      "default": "0001-01-01"
    },
    {
      "key": "nicknames",
      "label": "邮箱别名（不设置时显示邮箱地址）",
      "type": "list",
      "default": "[]",
      "maxItems": 20,
      "item": [
        {
          "key": "address",
          "label": "已连接的完整邮箱地址",
          "type": "text",
          "default": "请输入邮箱"
        },
        {
          "key": "alias",
          "label": "别名",
          "type": "text",
          "default": "请输入别名"
        }
      ]
    }
  ]
}
