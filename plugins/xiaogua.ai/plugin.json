{
  "id": "xiaogua.ai",
  "name": "小米mimo额度",
  "author": "W.g",
  "version": "1.0.0",
  "api": 1,
  "runtime": "js",
  "refreshSeconds": 600,
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "quota",
  "capabilities": [
    "settings",
    "quota.source",
    "storage",
    "timer",
    "island.pinned",
    "status.page",
    "status.canvas"
  ],
  "dataVersion": 1,
  "permissions": {
    "source.read": "https"
  },
  "network": {
    "hosts": [
      "token-plan-cn.xiaomimimo.com",
      "api.xiaomimimo.com"
    ],
    "sources": [
      {
        "key": "token_plan",
        "url": "https://token-plan-cn.xiaomimimo.com/v1/platform/token_plan"
      },
      {
        "key": "balance",
        "url": "https://api.xiaomimimo.com/v1/platform/balance"
      }
    ],
    "credential": {
      "label": "小米 MiMo API Key（sk- 或 tp-）",
      "header": "Authorization",
      "prefix": "Bearer "
    },
    "minRefreshSeconds": 60
  },
  "attribution": {
    "label": "小米 MiMo",
    "url": "https://api.xiaomimimo.com/"
  },
  "settings": [
    {
      "key": "quota_label",
      "label": "套餐额度标签",
      "type": "text",
      "default": "本期剩余"
    },
    {
      "key": "balance_label",
      "label": "余额标签",
      "type": "text",
      "default": "可用余额"
    },
    {
      "key": "reset_date",
      "label": "重置日期（接口未返回周期时使用）",
      "type": "date",
      "default": "2026-12-31"
    }
  ]
}
