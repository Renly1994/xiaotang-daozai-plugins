{
  "id": "hawkings.footballscoreboard",
  "name": "足球比分牌",
  "titleAccent": "比分牌",
  "author": "hawkings",
  "version": "1.2.6",
  "api": 1,
  "runtime": "js",
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "status",
  "capabilities": [
    "status.page",
    "status.canvas",
    "island.pinned",
    "settings",
    "storage",
    "timer",
    "action",
    "notice"
  ],
  "dataVersion": 1,
  "permissions": {
    "source.read": "https"
  },
  "refreshSeconds": 60,
  "network": {
    "hosts": [
      "site.api.espn.com"
    ],
    "sources": [
      {
        "key": "board",
        "url": "https://site.api.espn.com/apis/site/v2/sports/soccer/all/scoreboard?limit=50"
      },
      {
        "key": "chn",
        "url": "https://site.api.espn.com/apis/site/v2/sports/soccer/chn.1/scoreboard?limit=20"
      }
    ],
    "minRefreshSeconds": 60
  },
  "settings": [
    {
      "key": "intro",
      "label": "功能介绍",
      "type": "text",
      "default": "关注球队后，状态页显示实时比分和下一场；点「选球队」可跨联赛多选，常驻条显示两队队徽与比分。",
      "multiline": true
    }
  ],
  "statusLayout": {
    "components": [
      {
        "type": "canvas"
      }
    ],
    "style": {
      "accent": "#35D07F",
      "icon": "chart",
      "surface": "plain"
    }
  }
}
